# node-linker=hoisted is required for apps/mobile (Expo/Metro). Metro's
# module resolver does not reliably follow pnpm's default strict/symlinked
# node_modules layout: several Expo & RN packages (expo-router,
# react-native-web, expo-font, ...) reach into transitive dependencies
# (standard-navigation, @react-native/normalize-colors, expo-modules-core,
# ...) that pnpm keeps isolated and that Metro's resolver can't see unless
# node_modules is flattened.
#
# pnpm only honors `node-linker` from the WORKSPACE ROOT .npmrc (a
# per-package .npmrc override does not work — confirmed while scaffolding
# apps/mobile), so this applies to the whole monorepo, not just mobile.
# It should not change runtime behavior for apps/coach-web (Vite/Rollup
# resolve node_modules fine either way) or for supabase/ (no node_modules
# resolution involved), but flags it here since this file is shared.
#
# If this conflicts with other apps/packages added later, the alternative
# is moving apps/mobile out to its own nested pnpm project/lockfile —
# not attempted here to keep the workspace single-lockfile per Wave 0.
node-linker=hoisted
